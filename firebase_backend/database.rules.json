{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && !root.child('deletingAccounts/' + $uid).exists()"
        },
        "fcmTokens": {
          "$tokenId": {
            ".write": "auth != null && auth.uid === $uid && !root.child('deletingAccounts/' + $uid).exists()",
            ".validate": "newData.hasChildren(['token', 'platform', 'updatedAt']) && newData.child('token').isString() && newData.child('token').val().length >= 20"
          }
        },
        "devices": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "notificationPreferences": {
          ".write": "auth != null && auth.uid === $uid && !root.child('deletingAccounts/' + $uid).exists()"
        }
      }
    },

    "deletingAccounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "pairingClaims": {
      "$claimId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": false
      }
    },

    "deviceSecrets": {
      ".read": false,
      ".write": false
    },

    "notificationOutbox": {
      ".read": false,
      ".write": false
    },

    "devices": {
      "$deviceId": {
        ".read": true,

        "meta": {
          ".write": "auth != null || data.child('ownershipState').val() === 'RESET_PENDING'"
        },

        "acl": {
          ".write": "auth != null && (!data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid)"
        },

        "status": {
          ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
          ".validate": "newData.hasChildren(['online', 'lastSeenAt', 'bootId', 'mode', 'pumpState', 'irrigationState', 'ownershipEpoch'])"
        },

        "telemetry": {
          ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
          ".validate": "newData.hasChildren(['updatedAt', 'dhtValid', 'lightValid', 'reservoirValid', 'soil'])"
        },

        "weather": {
          ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'"
        },

        "config": {
          ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
          "mode": {
            ".validate": "newData.val() === 'OUTDOOR' || newData.val() === 'INDOOR'"
          },
          "rainThresholdPct": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 100"
          },
          "reservoirEmptyGapIn": {
            ".validate": "newData.isNumber() && newData.val() >= 3.0 && newData.val() <= 12.0"
          },
          "reservoirFullGapIn": {
            ".validate": "newData.isNumber() && newData.val() >= 0.6 && newData.val() < newData.parent().child('reservoirEmptyGapIn').val()"
          }
        },

        "commandRequests": {
          "$cmdId": {
            ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
            ".validate": "newData.hasChildren(['type', 'state', 'ownershipEpoch', 'createdAt', 'expiresAt']) && (newData.child('type').val() === 'WATER_CROP' || newData.child('type').val() === 'STOP_WATERING' || newData.child('type').val() === 'CLEAR_EMERGENCY' || newData.child('type').val() === 'MUTE_BUZZER') && (!newData.child('durationMs').exists() || (newData.child('durationMs').isNumber() && newData.child('durationMs').val() >= 1000 && newData.child('durationMs').val() <= 15000))",
            "state": {
              ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
              ".validate": "newData.val() === 'PENDING' || newData.val() === 'PROCESSED'"
            }
          }
        },

        "commandResults": {
          "$cmdId": {
            ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED'",
            ".validate": "newData.hasChildren(['commandId', 'state', 'reason', 'updatedAt', 'ownershipEpoch'])"
          }
        },

        "events": {
          ".indexOn": ["createdAt", "dedupeKey"],
          "$eventId": {
            ".write": "root.child('devices/' + $deviceId + '/meta/ownershipState').val() === 'OWNED' && !data.exists()",
            ".validate": "newData.hasChildren(['eventId', 'type', 'severity', 'title', 'message', 'dedupeKey', 'createdAt', 'ownershipEpoch']) && newData.child('ownershipEpoch').val() === root.child('devices/' + $deviceId + '/meta/ownershipEpoch').val()"
          }
        }
      }
    }
  }
}
